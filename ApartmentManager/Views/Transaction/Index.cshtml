@using ApartmentManager.ViewModels
@using ApartmentManager.ViewModels.Transaction
@model PaginatedList<TransactionsViewModel>
@{
	ViewData["Title"] = "Transactions";
}
<div class="d-flex justify-content-between">
	<h1>Transactions</h1>
	<div class="d-sm-flex mx-3">
		<div class="mb-1 mb-md-0">
			<form asp-action="Index" method="get">
				@if (ViewData["CurrentSearch"] != null)
				{
					<input hidden name="currentSearch" value="@ViewData["CurrentSearch"]" />
				}
				<input class="form-control" type="date" name="filterDate" value="@ViewData["FilterDate"]" onchange="this.form.submit();"/>
			</form>
		</div>
		<form asp-action="Index" method="get">
			@if (ViewData["FilterDate"] != null)
			{
				<input hidden name="filterDate" value="@ViewData["FilterDate"]" />
			}
			<div class="input-group mx-3">
				<input class="form-control" type="text" name="searchString" value="@ViewData["CurrentSearch"]" autocomplete="off" />
				<button class="btn btn-primary" type="submit">Search</button>
			</div>
		</form>
	</div>
</div>
<table class="table">
	<thead>
		<tr>
			<th>Tenant Name</th>
			<th>Purpose</th>
			<th>Amount</th>
			<th>Date</th>
			<th>Payment Method</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var transaction in Model)
		{
			<tr>
				<td>@transaction.TenantName</td>
				<td>@transaction.Purpose</td>
				<td>@transaction.Amount.ToString("C")</td>
				<td>@transaction.Date</td>
				<td>@transaction.MOP</td>
			</tr>
		}
	</tbody>
</table>

@{
	var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
	var nextDisabled = !Model.HasNextPage ? "disabled" : "";
}

<a asp-action="Index"
   asp-route-sortOrder="@ViewData["FilterDate"]"
   asp-route-pageNumber="@(Model.PageIndex - 1)"
   asp-route-currentSearch="@ViewData["CurrentSearch"]" 
   class="btn btn-primary @prevDisabled">
	Previous
</a>
<a asp-action="Index"
   asp-route-sortOrder="@ViewData["FilterDate"]"
   asp-route-pageNumber="@(Model.PageIndex + 1)"
   asp-route-currentSearch="@ViewData["CurrentSearch"]"
   class="btn btn-primary @nextDisabled">
	Next
</a>