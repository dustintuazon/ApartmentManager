@using ApartmentManager.ViewModels.Transaction
@model CreateTransactionViewModel
@{
	ViewData["Title"] = $"Payment - {Model.TenantName}";
}

<h1>Payment - @Model.TenantName</h1>
<form asp-action="ProcessPayment" asp-controller="Transaction" asp-route-id="@Model.TenantId" method="post" autocomplete="off">
	@Html.AntiForgeryToken()
	<div asp-validation-summary="ModelOnly" class="text-danger"></div>
	<div class="mb-3">
		<label asp-for="PaymentDate" class="form-label"></label>
		<input asp-for="PaymentDate" class="form-control"/>
		<span asp-validation-for="PaymentDate" class="text-danger"></span>
	</div>
	<div class="mb-3">
		<label asp-for="Purpose" class="form-label"></label>
		<select asp-for="Purpose" asp-items="Html.GetEnumSelectList<Purpose>().Where(a=> a.Text != Purpose.Advance.ToString())" class="form-select">
			<option value="">-- Select Purpose --</option>
		</select>
		<span asp-validation-for="Purpose" class="text-danger"></span>
	</div>
	<div class="mb-3">
		<label asp-for="Amount" class="form-label"></label>
		<input asp-for="Amount" class="form-control" />
		<span asp-validation-for="Amount" class="text-danger"></span>
	</div>
	<div class="mb-3">
		<label asp-for="ModeOfPayment" class="form-label"></label>
		<select asp-for="ModeOfPayment" asp-items="Html.GetEnumSelectList<ModeOfPayment>()" class="form-select">
			<option value="">-- Select Mode of Payment --</option>
		</select>
		<span asp-validation-for="ModeOfPayment" class="text-danger"></span>
	</div>
	<button type="submit" class="btn btn-success">Submit Payment</button>
</form>

@section Scripts{
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
	}
}