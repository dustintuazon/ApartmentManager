@using ApartmentManager.ViewModels.Tenant
@model ViewTenantViewModelWrapper
@{
	ViewData["Title"] = "Tenant Details"; 
}

<div class="container">
	<h3>Tenant: @Model.ViewTenantViewModel.TenantName</h3>
	<h4>Room: @Model.ViewTenantViewModel.RoomName</h4>
	<div class="mb-3">
		<p>Description: @Model.ViewTenantViewModel.Description</p>
		<p>Move-in Date: @Model.ViewTenantViewModel.MoveInDate.ToShortDateString()</p>
		@if (Model.ViewTenantViewModel.MoveOutDate is not null)
		{
			<p>Move-out Date: @Model.ViewTenantViewModel.MoveOutDate?.ToShortDateString()</p>
		}
		<p>Monthly: @Model.ViewTenantViewModel.Monthly.ToString("C")</p>
		<p>Balance: @Model.ViewTenantViewModel.Balance.ToString("C")</p>
		<p>Deposit: @Model.ViewTenantViewModel.Deposit.ToString("C")</p>
	</div>
</div>
@if (Model.ViewTenantViewModel.MoveOutDate > DateOnly.FromDateTime(DateTime.Now) || Model.ViewTenantViewModel.MoveOutDate is null)
{
	<div class="row">
		<div class="col-lg-3">
			<p>@Model.MoveOutDateViewModel.ResultMessage</p>
			<button class="btn btn-danger" type="button" data-bs-toggle="collapse" data-bs-target="#moveOutDateCollapse" aria-expanded="false" aria-controls="moveOutDateCollapse">
				@(Model.ViewTenantViewModel.MoveOutDate is null ? "Set" : "Change") Move-out Date
			</button>
		</div>
	</div>
	<div class="row collapse mt-3" id="moveOutDateCollapse">
		<div class="col-lg-6">
			<div class="card card-body">
				<form asp-action="UpdateMoveOutDate" method="post" asp-route-id="@Model.ViewTenantViewModel.TenantId">
					@Html.AntiForgeryToken()
					<div class="form-group mb-3">
						<label asp-for="MoveOutDateViewModel.MoveOutDate" class="control-label"></label>
						<input asp-for="MoveOutDateViewModel.MoveOutDate" class="form-control" />
						<span asp-validation-for="MoveOutDateViewModel.MoveOutDate" class="text-danger"></span>
					</div>
					<button type="submit" class="btn btn-success">@(Model.ViewTenantViewModel.MoveOutDate is null ? "Set" : "Change") Move-out Date</button>
				</form>
			</div>
		</div>
	</div>
}
<div class="container mt-3">
	<h3>Transactions</h3>
	<table class="table">
		<thead>
			<tr>
				<th>Purpose</th>
				<th>Amount</th>
				<th>Date</th>
				<th>Payment Method</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var transaction in Model.ViewTenantViewModel.Transactions)
			{
				<tr>
					<td>@transaction.Purpose</td>
					<td>@transaction.Amount.ToString("C")</td>
					<td>@transaction.Date.ToShortDateString()</td>
					<td>@transaction.MOP</td>
				</tr>
			}
		</tbody>
	</table>
</div>

<a class="btn btn-primary" asp-action="Index" asp-controller="Tenant">Back to List</a>