@using ApartmentManager.ViewModels
@using ApartmentManager.ViewModels.Room
@model PaginatedList<ViewRoomViewModel>
@{
	ViewData["Title"] = "Rooms"; 
}
<div class="d-flex justify-content-between align-items-center mb-3">
	<div class="">
		<h1>Rooms</h1>
		<a class="btn btn-primary" asp-action="CreateEditRoom" asp-controller="Room">Create Room</a>
	</div>

	<div class="d-md-flex justify-content-between gap-sm-3 mb-3">
		<form method="get" asp-action="Index">
			@if (ViewData["CurrentSearch"] != null)
			{
				<input type="hidden" name="searchString" value="@ViewData["CurrentSearch"]" />
			}
			<div class="d-flex gap-2 align-items-center mb-1 mb-md-0">
				<label for="sortOrder" class="text-nowrap">Sort By: </label>
				@Html.DropDownList("sortOrder", (SelectList)ViewBag.SortList, new { @class = "form-control", onchange = "this.form.submit();" })
			</div>
		</form>
		<form asp-action="Index" method="get">
			@if (ViewData["SortOrder"] != null)
			{
				<input type="hidden" name="sortOrder" value="@ViewData["SortOrder"]" />
			}
			<div class="input-group">
				<input type="text" class="form-control" name="searchString" value="@ViewData["CurrentSearch"]" autocomplete="off"/>
				<button class="btn btn-primary" type="submit">Search</button>
			</div>
		</form>	
	</div>
</div>


<div class="container-md">
	<div class="row">
		@foreach (var room in Model)
		{
			<div class="col-xl-3 col-lg-4">
				<div class="card mb-3 border-2 @(room.OccupiedBy == null ? "border-success" : "border-danger")">
					<div class="card-body">
						<div class="d-flex justify-content-between">
							<h4 class="card-title">@room.Name</h4>
							@if(room.OccupiedBy == null)
							{
								<div>
									<a class="btn btn-primary btn-sm align-self-center" asp-controller="Tenant" asp-action="AddTenant" asp-route-id="@room.Id">Add Tenant</a>
									<a class="btn btn-primary btn-sm align-self-center" asp-controller="Room" asp-action="CreateEditRoom" asp-route-id="@room.Id"><i class="bi bi-pencil"></i></a>
								</div>
							}
						</div>
						<p class="card-text my-1">@room.Description</p>
						<p class="card-text my-1">Monthly: @room.Monthly.ToString("C")</p>
						<p class="card-text my-1">@room.MonthsDeposit Month(s) Deposit</p>
						<p class="card-text my-1">@room.MonthsAdvance Month(s) Advance</p>
						<div class="d-flex">
							<p class="card-text my-1 border d-inline-block px-2 py-1 @(room.OccupiedBy == null ? "border-success text-success" : "border-danger text-danger") rounded">@(room.OccupiedBy == null ? "Available" : "Occupied")</p>
							@if (room.OccupiedBy != null)
							{
								<p class="card-text align-self-center ps-2">@room.OccupiedBy</p>
							}
						</div>
					</div>
				</div>
			</div>
		}
	</div>
</div>

@{
	var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
	var nextDisabled = !Model.HasNextPage ? "disabled" : "";
}

<div class="d-inline-flex gap-2">
	<a asp-action="Index"
	   asp-route-sortOrder="@ViewData["SortOrder"]"
	   asp-route-pageNumber="@(Model.PageIndex - 1)"
	   asp-route-currentSearch="@ViewData["CurrentSearch"]"
	   class="btn btn-sm btn-outline-primary @prevDisabled">
		Previous
	</a>
	<div class="input-group">
	</div>
	<a asp-action="Index"
	   asp-route-sortOrder="@ViewData["SortOrder"]"
	   asp-route-pageNumber="@(Model.PageIndex + 1)"
	   asp-route-currentSearch="@ViewData["CurrentSearch"]"
	   class="btn btn-sm btn-outline-primary @nextDisabled">
		Next
	</a>
</div>